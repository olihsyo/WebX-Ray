# WebX-Ray AI Configuration

# Application
APP_NAME="WebX-Ray AI"
APP_VERSION="1.0.0"
DEBUG=false

# Database (Default: SQLite local persistence, or configure PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./webxray.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/webxray"

# Security & SSRF
SECRET_KEY="replace-with-a-random-32-character-secret-key"
SSRF_PROTECTION=true
ALLOW_PRIVATE_IPS=false

# Browser & Crawl Engine
HEADLESS_BROWSER=true
DEFAULT_MAX_PAGES=25
DEFAULT_MAX_DEPTH=3
DEFAULT_TIMEOUT_MS=30000

# Optional AI Providers (System operates 100% offline if omitted)
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
# OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"
# ANTHROPIC_API_KEY="sk-ant-YourAnthropicApiKeyHere"

# Default Provider: gemini, openai, anthropic, or local
DEFAULT_AI_PROVIDER="local"
